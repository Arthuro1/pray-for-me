# Client (browser) vars MUST be VITE_-prefixed — Vite only exposes those.
VITE_ANTHROPIC_API_KEY=sk-ant-your_api_key_here
VITE_SUPABASE_URL=https://your_supabase_url_here.supabase.co/rest/v1/
VITE_SUPABASE_ANON_KEY=sb_publishable_your_anon_key_here
VITE_DONATION_URL=https://paypal.me/YOUR_PAYPAL_USERNAME
# Web Push: public VAPID key (generate with: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# "Sign in with YouVersion" (optional). Register an app at platform.youversion.com
# to get the App Key (OAuth client_id) and add the redirect URI:
#   https://YOUR_DOMAIN/auth/youversion/callback
# The login button stays hidden until this is set. It's public (appears in the
# authorize URL), so the VITE_ prefix is fine.
# VITE_YOUVERSION_APP_KEY=your_youversion_app_key_here

# Production only (set in Vercel, NOT bundled): the /api/anthropic proxy reads
# this server-side key so it never ships to the browser. Falls back to
# VITE_ANTHROPIC_API_KEY if unset.
# ANTHROPIC_API_KEY=sk-ant-your_api_key_here

# Production only (set in Vercel, NOT bundled): the /api/auth/youversion bridge
# mints a Supabase session for YouVersion logins. Service-role = god mode, so it
# must NEVER be VITE_-prefixed or shipped to the browser. (Also enable the Email
# provider in Supabase Auth so magic-link verification works.)
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
