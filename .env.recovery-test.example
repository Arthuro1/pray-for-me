# Isolated recovery testing only. npm run setup:recovery-test copies this file
# to .recovery-test/.env.local and never overwrites an existing local env.
# Start the separate local Supabase instance, then copy its anon/publishable
# and service-role/secret keys from `supabase --workdir .recovery-test status`.
# Do not copy keys or URLs from a hosted project or the ordinary .env.
VITE_SUPABASE_URL=http://127.0.0.1:55421
SUPABASE_URL=http://127.0.0.1:55421
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_LOCAL_ANON_KEY
SUPABASE_ANON_KEY=REPLACE_WITH_LOCAL_ANON_KEY
# Server-only key. Never add a VITE_ prefix to a service-role/secret key.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_LOCAL_SERVICE_ROLE_KEY

VITE_PRAYER_PROTECTION_ENABLED=true
VITE_RECOVERY_ALLOW_LOCALHOST=true
VITE_RECOVERY_LOCAL_ORIGIN=http://localhost:5173
RECOVERY_ENROLLMENT_ENABLED=true
RECOVERY_ALLOW_LOCALHOST=true
RECOVERY_LOCAL_ORIGIN=http://localhost:5173
